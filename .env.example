# PostgreSQL connection string from the Vercel-linked database provider.
DATABASE_URL=
# Server-side owner auth. Use a long random value for both secrets in production.
FACTORY_OWNER_PASSWORD=
FACTORY_SESSION_SECRET=
# Server-side model provider; required to run actual design/brief tasks.
OPENAI_API_KEY=
# Choose a model enabled for your OpenAI API project.
OPENAI_MODEL=
# Set model-specific rates in USD per million tokens. Model calls are disabled
# until both rates are set and an owner spending limit is configured.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
# Set the current OpenAI web search price in USD per search call. Research
# tasks stay disabled until this and the model token prices are configured.
OPENAI_WEB_SEARCH_USD_PER_CALL=
